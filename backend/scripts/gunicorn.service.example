# Example systemd unit for air-backend (92.5.10.116).
# Copy to the server:
#   sudo cp backend/scripts/gunicorn.service.example /etc/systemd/system/airquality.service
# Edit paths, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable airquality
#   sudo systemctl start airquality
#
# Set GitHub secret GUNICORN_SERVICE=airquality

[Unit]
Description=Air Quality Django API (Gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/airquality_mobile/backend
Environment="PATH=/home/ubuntu/airquality_mobile/venv/bin"
EnvironmentFile=/home/ubuntu/airquality_mobile/backend/.env
ExecStart=/home/ubuntu/airquality_mobile/venv/bin/gunicorn \
  --workers 3 \
  --bind 0.0.0.0:80 \
  --timeout 120 \
  airquality_api.core.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
